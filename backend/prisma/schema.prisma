generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 🛡️ SISTEMA DE ACESSOS E AUTENTICAÇÃO
// ==========================================
model User {
  id              String         @id @default(uuid())
  name            String
  agencyName      String?        
  email           String         @unique
  password        String
  avatarUrl       String?
  role            String         @default("ADMIN") 
  
  // Vínculos Oficiais
  companyAccessId String?        
  clientId        String?        // 🔥 MELHORIA 1: Vínculo inquebrável com a empresa cliente
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  companies       Company[]      
  refreshTokens   RefreshToken[] 
  createdAt       DateTime       @default(now())

  @@index([email]) // ⚡ Turbo para acelerar o Login
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==========================================
// 🏢 NÚCLEO DO ESCRITÓRIO (BPO / AGÊNCIA)
// ==========================================
model Company {
  id           String        @id @default(uuid())
  name         String
  document     String?       
  userId       String        
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  clients      Client[]
  transactions Transaction[]
  tickets      Ticket[]
  documents    Document[]
  tasks        Task[]
  auditLogs    AuditLog[]    // Relação com a Caixa Preta
  
  createdAt    DateTime      @default(now())
}

// ==========================================
// 💼 CRM: DOSSIÊ DE CLIENTES
// ==========================================
model Client {
  id                String        @id @default(uuid())
  fullName          String
  document          String?
  taxRegime         String?
  monthlyFee        Float         @default(0)
  status            String        @default("ATIVO") 
  email             String?
  phone             String?       
  certificateExpiry DateTime?
  
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  transactions      Transaction[]
  tickets           Ticket[]
  documents         Document[]
  tasks             Task[]
  users             User[]        // Usuários atrelados a este cliente
  
createdAt         DateTime      @default(now())

  @@index([companyId]) 
  @@index([companyId, status])
}

// ==========================================
// 💰 FINANCEIRO E FLUXO DE CAIXA
// ==========================================
model Transaction {
  id            String   @id @default(uuid())
  title         String   
  description   String?
  amount        Float
  type          String   
  category      String   
  date          DateTime
  status        String   @default("PAGO") 
  paymentMethod String?
  fileUrl       String?
  installments  Int      @default(1) // 🔥 MELHORIA 4: Registra se é mensalidade
  
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())

  @@index([companyId, date]) // ⚡ Turbo: Acelera filtros por data no dashboard
  @@index([clientId])
}

// ==========================================
// 🗄️ COFRE DIGITAL (GED)
// ==========================================
model Document {
  id          String   @id @default(uuid())
  name        String   
  category    String   
  fileUrl     String   
  
  clientId    String   
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  companyId   String   
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  readAt      DateTime?

  isSigned      Boolean   @default(false)
  signedAt      DateTime?
  signedByIp    String?
  signatureHash String?   // O código único inquebrável que comprova a assinatura

  @@index([companyId])
  @@index([clientId])
}

// ==========================================
// 📋 KANBAN FISCAL E OBRIGAÇÕES
// ==========================================
model Task {
  id          String   @id @default(uuid())
  title       String   
  description String?
  status      String   @default("A_FAZER") 
  priority    String   @default("NORMAL")  
  dueDate     DateTime 

  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  companyId   String   
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status]) 
  @@index([companyId, dueDate])
}

// ==========================================
// 💬 HELPDESK: CENTRAL DE CHAMADOS
// ==========================================
model Ticket {
  id              String          @id @default(uuid())
  subject         String
  department      String          
  description     String
  status          String          @default("ABERTO") 
  priority        String          @default("NORMAL")
  hasUnreadAdmin  Boolean         @default(false)
  hasUnreadClient Boolean         @default(false)
  
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  messages        TicketMessage[]
  
reatedAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model TicketMessage {
  id         String   @id @default(uuid())
  message    String
  senderRole String   
  senderName String
  
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

// ==========================================
// 🕵️‍♂️ CAIXA PRETA: TRILHA DE AUDITORIA
// ==========================================
model AuditLog {
  id          String   @id @default(uuid())
  action      String   // Ex: DELETE, UPDATE, CREATE
  module      String   // Ex: TRANSACTION, CLIENT, DOCUMENT
  details     String   // Ex: "Fatura de R$ 1500 deletada"
  userName    String   // Nome de quem fez a ação (registrado fisicamente para não se perder se o usuário for deletado)
  userRole    String   // Nível de acesso (ADMIN ou CLIENT)
  
  companyId   String   
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}