generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 👤 O Contador / Consultor (Dono do Escritório)
model User {
  id              String         @id @default(uuid())
  name            String
  agencyName      String?        
  email           String         @unique
  password        String
  avatarUrl       String?
  role            String         @default("ADMIN") // ADMIN ou CLIENT
  companyAccessId String?        
  
  companies       Company[]      
  refreshTokens   RefreshToken[] 
  createdAt       DateTime       @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 🏢 A Agência Contábil / Unidade de Negócio
model Company {
  id           String        @id @default(uuid())
  name         String
  document     String?       // CNPJ da Empresa
  userId       String        
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  clients      Client[]
  transactions Transaction[]
  tickets      Ticket[]
  documents    Document[]
  tasks        Task[]
  
  createdAt    DateTime      @default(now())
}

// 💼 CRM: O Dossiê do Cliente do Escritório
model Client {
  id                String        @id @default(uuid())
  fullName          String
  document          String?       // CNPJ do Cliente
  taxRegime         String?       // Simples Nacional, Lucro Presumido, etc
  monthlyFee        Float         @default(0)
  status            String        @default("ATIVO") // ATIVO, INADIMPLENTE, SUSPENSO
  email             String?       
  phone             String?       
  certificateExpiry DateTime?     // Vencimento do e-CNPJ (Usado no Robô de Prazos)
  
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  transactions      Transaction[]
  tickets           Ticket[]
  documents         Document[]
  tasks             Task[]
  
  createdAt         DateTime      @default(now())
}

// 💰 BPO FINANCEIRO: Fluxo de Caixa e Lançamentos
model Transaction {
  id            String   @id @default(uuid())
  title         String   
  description   String?  
  amount        Float
  type          String   // entrada (income) ou saida (outcome)
  category      String   // Honorários, Impostos, Folha, etc
  date          DateTime
  status        String   @default("PAGO") // PAGO, PENDENTE, ATRASADO
  paymentMethod String?  // PIX, Boleto, etc
  fileUrl       String?  // Link do comprovativo ou NF (PDF/Imagem)
  
  clientId      String?  
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
}

// 🗄️ COFRE DIGITAL (GED): Documentos Partilhados
model Document {
  id          String   @id @default(uuid())
  name        String   
  category    String   // Societário, Fiscal, Trabalhista, Alvarás
  fileUrl     String   
  
  clientId    String   
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  companyId   String   
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

// 📋 KANBAN FISCAL: Obrigações e Prazos Operacionais
model Task {
  id          String   @id @default(uuid())
  title       String   
  description String?  
  status      String   @default("A_FAZER") // A_FAZER, EM_ANDAMENTO, CONCLUIDO
  priority    String   @default("NORMAL")  // BAIXA, NORMAL, ALTA, URGENTE
  dueDate     DateTime 

  clientId    String?  
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  companyId   String   
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 💬 HELPDESK: Central de Atendimento e Tickets
model Ticket {
  id              String          @id @default(uuid())
  subject         String
  department      String          // Fiscal, Contábil, DP/RH, Legal
  description     String
  status          String          @default("ABERTO") // ABERTO, EM_ANDAMENTO, RESOLVIDO
  priority        String          @default("NORMAL")
  hasUnreadAdmin  Boolean         @default(false)
  hasUnreadClient Boolean         @default(false)
  
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  messages        TicketMessage[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model TicketMessage {
  id         String   @id @default(uuid())
  message    String
  senderRole String   // ADMIN ou CLIENT
  senderName String
  
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
}