generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// O Contador / Consultor (Dono do Sistema)
model User {
  id              String         @id @default(uuid())
  name            String
  agencyName      String?        
  email           String         @unique
  password        String
  avatarUrl       String?
  role            String         @default("ADMIN") 
  companyAccessId String?        
  
  companies       Company[]      
  refreshTokens   RefreshToken[] 
  createdAt       DateTime       @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id           String        @id @default(uuid())
  name         String
  document     String?       // CNPJ da Empresa
  userId       String        // O contador dono desta empresa
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  clients      Client[]
  transactions Transaction[]
  products     Product[]
  appointments Appointment[]
  
  createdAt    DateTime      @default(now())
}

model Client {
  id                String   @id @default(uuid())
  fullName          String
  document          String?
  taxRegime         String?
  monthlyFee        Float?
  email             String?
  phone             String?
  status            String   @default("ATIVO")

  billingDay        String?
  certificateExpiry DateTime?
  notes             String?

  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  appointments      Appointment[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Transaction {
  id            String   @id @default(uuid())
  title         String
  description   String?
  amount        Float
  type          String   
  category      String?
  
  status        String   @default("PAGO") 
  paymentMethod String? 
  fileUrl       String?  
  date          DateTime
  
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  
  companyId     String   
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  category    String?
  price       Float
  stock       Int      @default(0)
  
  companyId   String   
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  images      Image[]
  createdAt   DateTime @default(now())
}

model Image {
  id        String   @id @default(uuid())
  url       String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Appointment {
  id        String   @id @default(uuid())
  title     String   @default("Compromisso") 
  type      String   @default("REUNIAO")     
  date      DateTime
  notes     String?
  status    String   @default("pendente") 
  
  clientId  String?  
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  companyId String   
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}