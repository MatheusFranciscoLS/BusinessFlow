# Copie para .env e preencha. O arquivo .env nunca vai para o repositório.

# Banco de dados (Neon, Supabase ou outro PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Segredo para assinar os tokens de login. Use um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Endereço do painel (usado nos links dos e-mails)
FRONTEND_URL=https://flowbusiness.vercel.app

# E-mail de demonstração: Gmail com senha de app
EMAIL_USER=
EMAIL_PASS=

# E-mail de produção (opcional, tem prioridade sobre o Gmail acima):
# um serviço de envio por SMTP, com o domínio do escritório verificado.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=avisos@seudominio.com.br
