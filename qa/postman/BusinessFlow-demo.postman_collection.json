  "item": [
    {
      "name": "1. Entrada na demonstração",
      "item": [
        {
          "name": "Configuração pública",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"informa se a demonstração está ligada\", () => pm.expect(pm.response.json()).to.have.property(\"demoEnabled\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "config"
              ]
            }
          }
        },
        {
          "name": "Login demo como gestor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"devolve token e perfil ADMIN\", () => { pm.expect(j.token).to.be.a(\"string\"); pm.expect(j.user.role).to.eql(\"ADMIN\"); });",
                  "pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"profile\":\"gestor\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/demo-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "demo-login"
              ]
            }
          }
        },
        {
          "name": "Login demo como cliente (portal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"perfil CLIENT\", () => pm.expect(j.user.role).to.eql(\"CLIENT\"));",
